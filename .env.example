# --- Обов'язкове для віддаленого доступу до дашборду ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please
PUBLIC_URL=https://tenders.example.com     # використовується в посиланнях у Telegram
DOMAIN=tenders.example.com                 # лише для профілю https (Caddy)

# --- Telegram (створіть бота в @BotFather; chat id — у @userinfobot або з getUpdates) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Джерела та розклад (значення за замовчуванням) ---
SOURCES=ezam,ted,pz,bk
INCREMENTAL_MINUTES=60
LOOKBACK_DAYS=3
SWEEP_HOUR_WARSAW=2
DIGEST_HOUR_KYIV=7
BODY_SCAN=1
REQUEST_INTERVAL=0.35
# USER_AGENT="tenderwatch/0.1 (contact: you@example.com)"
